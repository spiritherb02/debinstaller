#!/usr/bin/env bash
#
# debinstall — 在 Arch Linux 上安装 Debian .deb 包
#
# 原理：把 .deb 的 data 树原样搬进一个真正的 Arch 包（.PKGINFO + .MTREE
#       + .INSTALL），再交给 pacman -U 安装。因此装出来的东西被 pacman
#       完整跟踪，可以用 pacman -R / -Ql / -Qk 正常管理。
#
# 依赖：dpkg(dpkg-deb) binutils(readelf) bsdtar fakeroot zstd pacman
#
# 作者：为 spiritherb 定制

set -uo pipefail

PROG=${0##*/}
VERSION=2.1.0
SHIMDIR=/usr/local/lib/debinstall/shims
LOCALROOT=${DEBINSTALL_LOCAL_ROOT:-$HOME/.local/debinst}

MODE=analyze          # analyze | install | local | extract | convert | uninstall-local | list-local
KEEP=0                # 保留生成的 Arch 包
ASSUME_YES=0
RUN_SCRIPTLETS=1
OVERWRITE=0
MAKE_DESKTOP=1        # 装完在桌面建快捷方式；--no-desktop 关闭（GUI 的复选框用它）
ALLOW_DANGER=0        # 非交互模式下放行高危脚本，需显式 --allow-dangerous
RUN_REMOVE_HOOKS=0    # 默认不在卸载时执行 .deb 的 prerm/postrm（见下方说明）
COMPAT_LIBS=1         # 装完自动补齐 Debian 专属运行库并生成兼容启动器；--no-compat 关闭
OUTDIR=
EXTRACT_DIR=
TARGET=

# Debian 专属运行库的落地位置。Arch 仓库里没有的那些 soname（如
# libnss_wrapper.so）从这里补，由生成的启动器通过 LD_LIBRARY_PATH 注入。
COMPAT_DIR=${DEBINSTALL_COMPAT_DIR:-$HOME/.local/lib/debcompat}
# 应用专属修复（如某个 Qt 版本要禁 GLX）写在 <app>.env 里，启动器会 source 它。
# 这样「工具无法通用得知」的修法不会在重新生成启动器时被冲掉。
COMPAT_ENV_DIR=${DEBINSTALL_COMPAT_ENV:-$HOME/.config/debinstall}

DEB=            # .deb 路径
WORK=           # 临时工作目录

# ---------------------------------------------------------------- 输出
# 注意：正常信息走 stdout。GUI（deb-install-ui）把 stderr 并进 stdout 读，
# 若信息走 stderr 会因块缓冲而整体跑到末尾，行序全乱。只有真错误走 stderr。
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    CR=$'\e[31m'; CG=$'\e[32m'; CY=$'\e[33m'; CC=$'\e[36m'; CB=$'\e[1m'; CD=$'\e[2m'; C0=$'\e[0m'
else
    CR=; CG=; CY=; CC=; CB=; CD=; C0=
fi
info() { printf '%s==>%s %s\n' "${CB}${CC}" "$C0" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$CG" "$C0" "$*"; }
warn() { printf '  %s!%s %s\n' "$CY" "$C0" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$CR" "$C0" "$*"; }
err()  { printf '%s==>%s %s\n' "${CB}${CR}" "$C0" "$*" >&2; }
msg()  { printf '%s\n' "$*"; }
die()  { err "$*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<'EOF'
debinstall — 在 Arch Linux 上安装 Debian .deb 包

用法：
  debinstall [选项] <文件.deb>

模式：
  （默认）              只读分析（不动系统）：依赖、安装脚本审计、写入路径、冲突
      --install         分析之后真正安装（转成 Arch 包交给 pacman）
  -l, --local          解包安装到 ~/.local，不需要 root
  -x, --extract <目录>  仅把 .deb 的数据树解包到指定目录
  -c, --convert        只生成 Arch 包，不安装（输出到 --output 或当前目录）
  -L, --list-local     列出用 --local 装过的包
  -R, --remove-local <包名>
                       卸载用 --local 装过的包

选项：
  -o, --output <目录>  -c 模式下 Arch 包的输出目录（默认当前目录）
  -k, --keep           保留生成的 Arch 包（放到 --output 或当前目录）
  -y, --yes            不再询问（--install 时默认要确认）
      --overwrite      允许覆盖已存在的文件（pacman --overwrite，慎用）
      --no-compat      不自动补 Debian 专属运行库、不生成兼容启动器
      --no-scriptlet   不执行 .deb 自带的 postinst / prerm 等脚本
      --allow-dangerous
                       非交互模式下，明知脚本含高危操作仍要安装
      --run-remove-hooks
                       卸载时也执行 .deb 的 prerm / postrm（默认不执行）
  -h, --help           显示本帮助
  -v, --version        显示版本

说明：
  * 默认只做只读分析，看清楚再 --install。这是刻意设计的：.deb 自带的
    postinst 是外来脚本，装之前应该先过一眼。
  * 依赖优先从 .deb 内 ELF 的 NEEDED 声名中推导，再用 pacman 的文件数据库
    反查真正的 Arch 包名，比按包名字面翻译准确得多。
  * 安装走「转成真 Arch 包 + pacman -U」，装完被 pacman 完整跟踪，
    可以用 pacman -R / -Ql / -Qo / -Qk 正常管理。
  * 若 pacman 因文件冲突拒绝安装，改用 -l 装到用户目录（不需要 root），
    或加 --overwrite 明确允许覆盖。
  * 只发 .deb 的国产客户端常链接 Arch 没有的 Debian 专属库（libnss_wrapper.so
    之类）。装完会自动从 Debian 官方源取这些库放到 ~/.local/lib/debcompat，
    并生成兼容启动器 + 用户级桌面入口把 LD_LIBRARY_PATH 注入进去。
    应用专属修复写 ~/.config/debinstall/<应用名>.env（重新生成不会被冲掉）。
EOF
}

# ---------------------------------------------------------------- 参数
while [ $# -gt 0 ]; do
    case "$1" in
        --install)         MODE=install ;;
        -i|--info)         MODE=analyze ;;
        -l|--local)        MODE=local ;;
        -x|--extract)      MODE=extract; shift; EXTRACT_DIR=${1:-} ;;
        -c|--convert)      MODE=convert ;;
        -L|--list-local)   MODE=list-local ;;
        -R|--remove-local) MODE=uninstall-local; shift; TARGET=${1:-} ;;
        -o|--output)       shift; OUTDIR=${1:-} ;;
        -k|--keep)         KEEP=1 ;;
        -y|--yes)          ASSUME_YES=1 ;;
    --overwrite)       OVERWRITE=1 ;;
    --no-desktop)      MAKE_DESKTOP=0 ;;
    --no-compat)       COMPAT_LIBS=0 ;;
    --allow-dangerous) ALLOW_DANGER=1 ;;
    --run-remove-hooks) RUN_REMOVE_HOOKS=1 ;;
    --no-scriptlet)    RUN_SCRIPTLETS=0 ;;
        -h|--help)         usage; exit 0 ;;
        -v|--version)      echo "$PROG $VERSION"; exit 0 ;;
        --)                shift; break ;;
        -*)                die "未知选项：$1（用 -h 看帮助）" ;;
        *)                 [ -z "$DEB" ] && DEB=$1 || die "只能处理一个 .deb 文件" ;;
    esac
    shift
done
[ $# -gt 0 ] && { [ -z "$DEB" ] && DEB=$1; }

case "$MODE" in
    list-local)
        [ -d "$LOCALROOT" ] || { info "还没有用 --local 装过任何包"; exit 0; }
        printf '%-24s %-16s %s\n' "包名" "版本" "位置"
        for d in "$LOCALROOT"/*/; do
            [ -d "$d" ] || continue
            n=$(basename "$d")
            v=$(sed -n 's/^version=//p' "$d/.debinstall-info" 2>/dev/null | head -1)
            printf '%-24s %-16s %s\n' "$n" "${v:--}" "${d%/}"
        done
        exit 0 ;;
    uninstall-local)
        [ -n "$TARGET" ] || die "请给出要卸载的包名：debinstall -R <包名>"
        d="$LOCALROOT/$TARGET"
        [ -d "$d" ] || die "没有找到 $d"
        if [ -f "$d/.debinstall-manifest" ]; then
            while IFS= read -r f; do
                [ -n "$f" ] && [ -e "$f" ] && rm -f "$f"
            done < "$d/.debinstall-manifest"
        fi
        rm -rf "$d"
        have update-desktop-database && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1
        ok "已卸载 $TARGET"
        exit 0 ;;
esac

[ -n "$DEB" ] || { usage >&2; exit 1; }
[ -f "$DEB" ] || die "找不到文件：$DEB"
DEB=$(readlink -f "$DEB")

for c in dpkg-deb bsdtar fakeroot zstd pacman; do
    have "$c" || die "缺少 $c，请先安装（pacman -S dpkg binutils fakeroot zstd）"
done

cleanup() { [ -n "$WORK" ] && [ -d "$WORK" ] && rm -rf "$WORK"; }
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------- 提权
SUDO=()
detect_escalation() {
    [ "$(id -u)" -eq 0 ] && { SUDO=(); return; }

    # 终端里：正常问密码
    if [ -t 0 ] && have sudo; then SUDO=(sudo); return; fi

    # 图形界面（无控制终端）：优先用自带 GTK 密码框，凭据会缓存，不用反复输
    if [ -z "${SUDO_ASKPASS:-}" ]; then
        local _c
        for _c in "$HOME/.local/bin/deb-install-askpass" /usr/bin/ksshaskpass; do
            [ -x "$_c" ] && { SUDO_ASKPASS=$_c; export SUDO_ASKPASS; break; }
        done
    fi
    if [ -n "${SUDO_ASKPASS:-}" ] && [ -x "$SUDO_ASKPASS" ] && have sudo; then
        SUDO=(sudo -A); return
    fi

    # 兜底：polkit 图形授权
    if have pkexec && { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }; then
        SUDO=(pkexec); return
    fi

    have sudo && { SUDO=(sudo); return; }
    die "需要 root 权限，但 sudo / pkexec 都不可用"
}
run_root() {
    if [ ${#SUDO[@]} -eq 0 ]; then "$@"; else "${SUDO[@]}" "$@"; fi
}
PACMAN=$(command -v pacman)

# ---------------------------------------------------------------- 安全体检
# .deb 自带的 postinst / prerm 是外来脚本，装下去就会以 root 执行。
# 这里用正则过一遍，命中就停下来让人看清楚，绝不静默执行。
DANGER=0
DANGER_RE='rm[[:space:]]+-[a-zA-Z]*[rR][a-zA-Z]*[[:space:]]+(--[[:space:]]+)?/([[:space:]]|$)|rm[[:space:]]+-[rR][a-zA-Z]*[[:space:]]+-[a-zA-Z]*[[:space:]]+/([[:space:]]|$)|dd[[:space:]][^|]*of=/dev/|mkfs\.|>[[:space:]]*/dev/(sd|nvme|vd|mmcblk)|(curl|wget)[^|]*\|[[:space:]]*(ba|z|k)?sh|chown[[:space:]]+-R[[:space:]]+[^[:space:]]+[[:space:]]+/([[:space:]]|$)|chmod[[:space:]]+-R[[:space:]]+[0-7]*777[[:space:]]+/|:\(\)\{[[:space:]]*:\|:&'

audit_scriptlets() {   # $1 = ctl 目录；命中高危则置 DANGER=1
    local ctl=$1 f n=0
    for f in preinst postinst prerm postrm; do
        [ -s "$ctl/$f" ] || continue
        n=$((n+1))
        # 供 GUI 摘要卡片识别：preinst 12 行
        printf '  %s %s 行\n' "$f" "$(wc -l < "$ctl/$f")"
        if grep -qE "$DANGER_RE" "$ctl/$f"; then
            DANGER=1
            printf '  %s✗ 上面这个脚本含高危操作，装之前请人工确认！%s\n' "$CR" "$C0"
            grep -nE "$DANGER_RE" "$ctl/$f" | sed 's/^/        /'
        fi
    done
    [ $n -eq 0 ] && printf '  %s✓ 没有安装脚本（无 postinst 等）%s\n' "$CG" "$C0"
    printf '      %s（Arch 上没有 dpkg，update-alternatives / AppArmor 这类逻辑多半会被跳过）%s\n' "$CD" "$C0"
    if [ $RUN_REMOVE_HOOKS -eq 0 ]; then
        printf '      %sprerm / postrm 在卸载时不会被执行（要执行加 --run-remove-hooks）%s\n' "$CD" "$C0"
    else
        printf '      %s! 已开启 --run-remove-hooks：卸载时 prerm / postrm 会以 root 执行%s\n' "$CY" "$C0"
    fi
    return 0
}

check_top_paths() {    # $1 = 解包后的根目录
    local root=$1 unsafe
    unsafe=$(find "$root" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null |
             grep -vxE 'opt|usr|etc|var|lib|lib64|share|bin|sbin|run|tmp' || true)
    [ -n "$unsafe" ] && warn "包含非常规顶层目录，请留意：$(echo $unsafe | tr '\n' ' ')"
    printf '  %s写入的顶层路径：%s%s\n' "$CD" \
        "$(find "$root" -mindepth 1 -maxdepth 1 -printf '%f ' 2>/dev/null)" "$C0"
    return 0
}

# desktop 文件里的 Exec 第一个 token 在当前系统上是否可执行。
# 用来判断「用户级那份」和「包内这份」谁更可能是好的 —— 光看存在性不够：
# 用户级那份可能是之前装坏留下的，包内这份也可能是带发行版检查的脚本。
desktop_exec_ok() {   # $1 = .desktop 路径
    local e
    e=$(awk -F= '/^Exec=/{print $2; exit}' "$1" 2>/dev/null | awk '{print $1}')
    [ -n "$e" ] || return 1
    case "$e" in
        /*) [ -x "$e" ] ;;
        *)  have "$e" ;;
    esac
}

check_desktop_shadow() {   # $1 = 解包后的根目录
    local root=$1 d ud hit=0
    [ -d "$root/usr/share/applications" ] || { ok "没有 desktop 遮蔽冲突（包内没有 .desktop）"; return 0; }
    for d in "$root"/usr/share/applications/*.desktop; do
        [ -f "$d" ] || continue
        ud="$HOME/.local/share/applications/$(basename "$d")"
        [ -e "$ud" ] || continue
        hit=1
        if cmp -s "$d" "$ud"; then
            warn "$(basename "$d") 用户级与包内内容相同（用户级优先，装完效果一致）"
            continue
        fi
        local uok=0 nok=0
        desktop_exec_ok "$ud" && uok=1
        desktop_exec_ok "$d"  && nok=1
        warn "$(basename "$d") 用户级那份会遮蔽本次要装的同名文件，且内容不同"
        if grep -q '^X-DebInstall-Wrapper=1' "$ud" 2>/dev/null; then
            printf '        → %s用户级那份是本工具生成的兼容启动器入口，正常现象，保留即可%s\n' "$CG" "$C0"
            printf '          （它负责注入 LD_LIBRARY_PATH，删掉会让应用起不来）\n'
        elif [ $uok -eq 1 ] && [ $nok -eq 0 ]; then
            printf '        → 用户级的 Exec 可用、包内这份不可用：%s保留用户级，不要 mv 走%s\n' "$CG" "$C0"
        elif [ $uok -eq 0 ] && [ $nok -eq 1 ]; then
            printf '        → 用户级的 Exec 不可用（多半是上次装坏留下的），包内这份可用\n'
            printf '          删掉坏的那份让新的生效：mv %s{,.bak}\n' "$ud"
        elif [ $uok -eq 0 ] && [ $nok -eq 0 ]; then
            printf '        → 两份的 Exec 都不可用，先确认主程序路径再决定\n'
            printf '          对比：grep ^Exec= %s %s\n' "$ud" "$d"
        else
            printf '        → 两份都可用，用户级那份像是你自定义过的\n'
            printf '          想用新装的这份：mv %s{,.bak}\n' "$ud"
        fi
    done
    [ $hit -eq 0 ] && ok "没有 desktop 遮蔽冲突"
    return 0
}

check_ll_cli() {           # $1 = 包名
    have ll-cli || return 0
    if XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)} ll-cli list 2>/dev/null | grep -qi "$1"; then
        warn "玲珑里已装了类似的应用，注意单实例锁会互相顶掉"
    fi
    return 0
}

# 从 .deb 里列出它会装的桌面入口
deb_desktop_files() {
    dpkg-deb -c "$DEB" 2>/dev/null | awk '{print $NF}' | sed 's|^\./||' \
        | grep -E '^usr/share/applications/[^/]+\.desktop$'
}

# 在桌面放快捷方式：名字优先取 Name[zh_CN]，回退 Name，再回退文件名。
# $1 = 桌面入口所在目录（系统安装是 /usr/share/applications，
#      本地安装是 ~/.local/share/applications —— 后者路径已被改写，必须用哪份取哪份）
make_desktop_shortcut() {
    local srcdir=${1:-/usr/share/applications}
    local ddir rel src label dest made=0
    ddir=$(xdg-user-dir DESKTOP 2>/dev/null)
    [ -n "$ddir" ] || ddir="$HOME/Desktop"
    if [ ! -d "$ddir" ]; then
        warn "桌面目录不存在，跳过：$ddir"
        return 0
    fi
    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        src="$srcdir/$(basename "$rel")"
        [ -f "$src" ] || continue
        # 补库生成过带 wrapper 标记的用户级版本 → 桌面那份要用它，
        # 否则桌面图标仍指向没注入 LD_LIBRARY_PATH 的原始 Exec。
        local uw="$HOME/.local/share/applications/$(basename "$rel")"
        if [ -f "$uw" ] && grep -q '^X-DebInstall-Wrapper=1' "$uw" 2>/dev/null; then
            src="$uw"
        fi
        label=$(awk -F= '/^Name\[zh_CN\]=/{print $2; exit}' "$src")
        [ -n "$label" ] || label=$(awk -F= '/^Name=/{print $2; exit}' "$src")
        [ -n "$label" ] || label=$(basename "$rel" .desktop)
        dest="$ddir/$label.desktop"
        # 桌面快捷方式是「用户自己的东西」：内容一样就不动，不一样先备份再覆盖。
        # 之前是无条件 cp -f，用户改过的 Exec（比如指向自己写的兼容启动器）
        # 会被静默冲掉，重新装一次就退回到坏的状态。
        if [ -e "$dest" ]; then
            if cmp -s "$src" "$dest"; then
                ok "桌面快捷方式已是最新 → $dest"
                made=1
                continue
            fi
            local bak="$dest.bak-$(date +%Y%m%d-%H%M%S)"
            cp -f "$dest" "$bak" && warn "原桌面快捷方式已备份 → $bak"
        fi
        if cp -f "$src" "$dest" && chmod +x "$dest"; then
            ok "桌面快捷方式 → $dest"
            made=1
        fi
    done < <(deb_desktop_files)
    [ "$made" -eq 0 ] && warn "这个包里没有 .desktop，跳过桌面快捷方式"
    return 0
}

# ---------------------------------------------------------------- alternatives 模拟
# SHIMDIR 里的 update-alternatives shim（base64 内嵌，避免转义问题）
_ALT_SHIM_B64=""

# 把 shim 落到指定目录；$1 = 目录，$2 = 可选前缀命令（如 run_root）
write_shim() {
    local dir=$1; shift
    if [ -x "$dir/update-alternatives" ]; then return 0; fi
    "$@" mkdir -p "$dir" 2>/dev/null || return 1
    printf '%s' "$_ALT_SHIM_B64" | base64 -d \
        | "$@" tee "$dir/update-alternatives" >/dev/null 2>&1 || return 1
    "$@" chmod 755 "$dir/update-alternatives" 2>/dev/null
    return 0
}

# 本地模式下模拟 update-alternatives。
# 本地安装不会执行 .deb 的 postinst，所以「命令名靠 alternatives 生成」的包
# （最典型就是 figlet：包里只有 figlet-utf8，/usr/bin/figlet 是链接出来的）
# 装完会少掉那个通用命令名。这里直接扫 postinst 里的 --install 调用补上。
emulate_alternatives_local() {   # $1=本地根 $2=ctl 目录 $3=manifest
    local dest=$1 ctl=$2 man=$3 f made=0
    for f in preinst postinst; do
        [ -s "$ctl/$f" ] || continue
        while IFS="$(printf '\t')" read -r link target; do
            [ -n "$link" ] && [ -n "$target" ] || continue
            local rel="${target}"
            case "$rel" in
                /usr/*|/opt/*) : ;;
                *) continue ;;                     # 相对路径不可靠，跳过
            esac
            local real="$dest$rel"
            [ -e "$real" ] || continue
            local base; base=$(basename "$link")
            local where="$HOME/.local/bin/$base"
            [ -e "$where" ] && [ ! -L "$where" ] && continue    # 别覆盖真程序
            if ln -sfn "$real" "$where" 2>/dev/null; then
                ok "命令别名 $base → $rel（模拟 update-alternatives）"
                [ -n "$man" ] && echo "$where" >> "$man"
                made=1
            fi
        done < <(awk '
            { buf = buf " " $0 }
            END {
                # 先按空白切，再滤掉空串和续行反斜杠，
                # 这样后三个位置才是稳定的「链接 / 名 / 目标」。
                n0 = split(buf, raw, /[ \t]+/)
                m = 0
                for (i = 1; i <= n0; i++) {
                    if (raw[i] == "" || raw[i] == "\\") continue
                    m++; c[m] = raw[i]
                }
                for (i = 1; i <= m; i++) {
                    if (c[i] == "--install" && c[i-1] ~ /update-alternatives/) {
                        if (c[i+1] != "" && c[i+3] != "") print c[i+1] "\t" c[i+3]
                    }
                }
            }
        ' "$ctl/$f")
    done
    return 0
}

fix_electron() {           # 装完扫 chrome-sandbox，顺手修权限
    local sb
    sb=$(find /opt /usr/lib -maxdepth 4 -name chrome-sandbox -newermt '-3 minutes' 2>/dev/null | head -1)
    [ -n "$sb" ] || return 0
    # Linux 6.x 内核下非特权 user namespace 可用就不需要 SUID，留 0755 更安全
    if [ -e /proc/sys/kernel/unprivileged_userns_clone ] &&
       [ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)" = "0" ]; then
        run_root chmod 4755 "$sb" && ok "chrome-sandbox → 4755（SUID，本机禁用了 user namespace）"
    elif unshare --user true 2>/dev/null; then
        run_root chmod 0755 "$sb" && ok "chrome-sandbox → 0755（user namespace 可用，无需 SUID）"
    else
        run_root chmod 4755 "$sb" && ok "chrome-sandbox → 4755（SUID 回退）"
    fi
    return 0
}

# ================================================================ Debian 补库
# 有些只发 .deb 的国产客户端（网易邮箱大师是典型）会链接 Arch 仓库里根本
# 不存在的 soname。实测两类：
#   1) Debian 专属库      如 libnss_wrapper.so —— Arch 全仓库（含 archlinuxcn）
#                         都没有，pacman -F 查不到，只能从 Debian 取；
#   2) 旧 soname          如 libsasl2.so.2 —— Arch 的 libsasl 只给 .so.3。
#                         这类 Debian 也有对应包（libsasl2-2），直接取更干净。
#
# 所以策略统一为「去 Debian 取」：soname → Debian 包名（查官方 Contents 索引）
# → .deb 直链（查官方 download 页）→ 解包抽出 usr/lib/ 下的 .so* → 落到
# $COMPAT_DIR。取回来的库若自身还缺依赖，会继续补（最多 3 轮）。
#
# 配套生成一个用户级启动器，把 LD_LIBRARY_PATH 注入进去 —— 因为往 /usr/lib
# 塞库需要 root 且会污染系统，而改 /opt 里的文件会被 pacman 升级冲掉。
# 启动器 + 用户级 .desktop 的整套思路见 SKILL.md「兼容启动器」一节。

http_get() {   # $1 = url；回显响应体
    local u=$1
    if have curl; then
        curl -fsSL --max-time 45 -A "debinstall/$VERSION (Arch Linux deb converter)" "$u" 2>/dev/null
    elif have wget; then
        wget -qO- --timeout=45 --user-agent="debinstall/$VERSION" "$u" 2>/dev/null
    else
        return 1
    fi
}

# 从 Contents 索引查某个 soname 由哪个 Debian 二进制包提供。
# 回显 "<suite> <包名>"；查不到返回 1。
debian_pkg_for_soname() {
    local so=$1 html suite pkg
    html=$(http_get "https://packages.debian.org/search?searchon=contents&keywords=${so}&mode=exactfilename&suite=stable&arch=amd64") || return 1
    [ -n "$html" ] || return 1
    # 结果都在唯一那张 <table> 里，每行形如：
    #   <td class="file">/usr/lib/x86_64-linux-gnu/...xxx.so</td> <td><a href="/trixie/pkg">pkg</a></td>
    # 先压平行、再只保留表格段，避免把导航链接（全是单段路径）算进来。
    pkg=$(printf '%s' "$html" | tr '\n' ' ' \
          | sed -n 's|.*<table>\(.*\)</table>.*|\1|p' \
          | grep -oE 'href="/[a-z0-9-]+/[A-Za-z0-9][A-Za-z0-9._+-]*"' \
          | sed -e 's|href="/||' -e 's|"$||' | awk -F/ '!seen[$2]++{print; exit}')
    [ -n "$pkg" ] || return 1
    suite=${pkg%%/*}; pkg=${pkg#*/}
    printf '%s %s\n' "$suite" "$pkg"
}

# Debian 包名 → .deb 的官方 CDN 直链。download 页列的是各镜像的绝对 URL，
# 从中剥出 pool/... 相对路径，再统一挂到 deb.debian.org 上（最稳的官方入口）。
# 注意别用「去掉 http://host/ 前缀」的写法：镜像 URL 形如
#   http://ftp.at.debian.org/debian/pool/main/n/nss-wrapper/xxx.deb
# 去掉 host 后还留着发行版名 debian/，再拼 deb.debian.org/debian/ 就重复了。
debian_deb_url() {   # $1 = 包名, $2 = suite
    local html rel
    html=$(http_get "https://packages.debian.org/$2/amd64/$1/download") || return 1
    [ -n "$html" ] || return 1
    rel=$(printf '%s' "$html" | grep -oE 'pool/[^"]*_amd64\.deb' | head -1)
    # 少数包只有 all 架构（纯数据/脚本）
    [ -n "$rel" ] || rel=$(printf '%s' "$html" | grep -oE 'pool/[^"]*_all\.deb' | head -1)
    [ -n "$rel" ] || return 1
    printf 'https://deb.debian.org/debian/%s\n' "$rel"
}

# 逐个 lib 目录地扫一个已解包树，回显它缺的 soname（一行一个）
missing_sonames() {   # $1 = 已解包的根目录；$2.. = 额外要一起看的目录（如 COMPAT_DIR）
    local shipped need resolved s pkg d extra=""
    local roots=("$@")
    shipped=$(shipped_sonames "$1")
    # $2.. 里已补进来的库也算 shipped，否则第二轮会把刚补上的库再当成缺失
    for d in "${roots[@]:1}"; do
        [ -d "$d" ] && extra="$extra$(shipped_sonames "$d")"$'\n'
    done
    need=""
    for d in "${roots[@]}"; do
        [ -d "$d" ] || continue
        need="$need$(elf_sonames "$d")"$'\n'
    done
    need=$(printf '%s\n' "$need" | grep -v '^$' | sort -u)
    shipped=$(printf '%s\n%s\n' "$shipped" "$extra" | grep -v '^$' | sort -u)
    need=$(printf '%s\n' "$need" | grep -vxF "$shipped" 2>/dev/null || true)
    resolved=$(printf '%s\n' "$need" | resolve_sonames)
    for s in $need; do
        pkg=$(awk -F'\t' -v k="$s" '$1==k{print $2; exit}' <<<"$resolved")
        [ -z "$pkg" ] && printf '%s\n' "$s"
    done
}

# 下载一个 Debian 包，把里面的 .so* 抽到 $COMPAT_DIR。回显补进来的文件名。
fetch_debian_libs() {   # $1 = Debian 包名, $2 = suite
    local pkg=$1 suite=$2 url tmp rc=0
    url=$(debian_deb_url "$pkg" "$suite") || return 1
    tmp=$(mktemp -d) || return 1
    if ! http_get "$url" > "$tmp/p.deb" 2>/dev/null || [ ! -s "$tmp/p.deb" ]; then
        rm -rf "$tmp"; return 1
    fi
    mkdir -p "$tmp/x"
    dpkg-deb -x "$tmp/p.deb" "$tmp/x" 2>/dev/null || { rm -rf "$tmp"; return 1; }
    mkdir -p "$COMPAT_DIR"
    # 保留 usr/lib/... 下的相对层级没有意义（loader 不递归），全部平铺到
    # COMPAT_DIR；符号链接跟着一起复制，否则只有 soname 里的 .so.N 没有实体名。
    while IFS= read -r -d '' f; do
        cp -a "$f" "$COMPAT_DIR/" 2>/dev/null || rc=1
    done < <(find "$tmp/x" \( -path '*/usr/lib/*' -o -path '*/lib/*' \) \
                  \( -name '*.so' -o -name '*.so.*' \) -print0 2>/dev/null)
    rm -rf "$tmp"
    return $rc
}

# 主流程：把当前包缺的库尽量补齐。$1 = 已解包的 .deb 根目录
setup_compat_libs() {
    local root=$1 round s pkg suite added=0 failed="" needs_wrapper=0
    local -a todo
    info "检查 Debian 专属运行库"

    # 这个应用是否**依赖** debcompat 里的库？判断方式是「不把 COMPAT_DIR 算作
    # 已满足」再问一次。这一步不能省：第二次安装时库早就在 COMPAT_DIR 里了，
    # 不需要再下载，但启动器仍然必须存在且接线正确 —— 用户可能删过它，
    # 或者 /opt 刚被 pacman 覆盖过。只看「这轮要不要下东西」会漏掉这种情况，
    # 表现为「第一次装好好的，重装一次图标就失灵」。
    local -a bare
    mapfile -t bare < <(missing_sonames "$root")
    [ ${#bare[@]} -gt 0 ] && needs_wrapper=1

    for round in 1 2 3; do
        # 每轮都重扫：上一轮补进来的库可能又引出新的缺失
        mapfile -t todo < <(missing_sonames "$root" "$COMPAT_DIR")
        if [ ${#todo[@]} -eq 0 ]; then
            [ $round -eq 1 ] && ok "依赖完整，无需补库"
            break
        fi
        [ $round -eq 1 ] && printf '  %s!%s 缺 %d 个 Arch 仓库不提供的库，尝试从 Debian 补齐：%s\n' \
            "$CY" "$C0" "${#todo[@]}" "${todo[*]}"
        local progressed=0
        for s in "${todo[@]}"; do
            read -r suite pkg < <(debian_pkg_for_soname "$s") || true
            if [ -z "${pkg:-}" ]; then
                printf '    %-28s → %s未在 Debian 找到%s\n' "$s" "$CY" "$C0"
                failed="$failed$s "; continue
            fi
            if fetch_debian_libs "$pkg" "$suite"; then
                printf '    %-28s → %s ← Debian %s\n' "$s" "$pkg" "$pkg"
                added=1; progressed=1
            else
                printf '    %-28s → %s下载失败（Debian %s）%s\n' "$s" "$CR" "$pkg" "$C0"
                failed="$failed$s "
            fi
        done
        [ $progressed -eq 0 ] && break
    done

    if [ $added -eq 1 ]; then
        ok "兼容库已就位：$COMPAT_DIR"
        mapfile -t todo < <(missing_sonames "$root" "$COMPAT_DIR")
        [ ${#todo[@]} -gt 0 ] && warn "仍有未解析的库：${todo[*]}"
    elif [ -n "$failed" ]; then
        warn "以下库没能补上，应用可能起不来：$failed"
    fi

    # 只要这个应用依赖 debcompat，就保证启动器 + 用户级桌面入口在位。
    # 放在最后统一处理，避免「无需下载」这条路径漏掉接线。
    [ $needs_wrapper -eq 1 ] && make_compat_wrapper "$root"
    return 0
}

# 从包内的 .desktop 里找主程序，生成用户级启动器 + 用户级 .desktop。
# 为什么必须生成启动器：LD_LIBRARY_PATH 得有人注入，而：
#   * 改 /opt 里的文件 → 会被 pacman 升级覆盖，且不在包清单里
#   * 往 /usr/lib 塞库   → 需要 root 且污染系统
#   * 用户级 .desktop 优先于 /usr/share/applications，正好用来挂启动器
make_compat_wrapper() {
    local root=$1 d appdir exec_cmd bin title srcname dest

    d=$(find "$root/usr/share/applications" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -1)
    [ -n "$d" ] || { warn "包内没有 .desktop，跳过启动器生成"; return 0; }
    exec_cmd=$(awk -F= '/^Exec=/{print $2; exit}' "$d" | awk '{print $1}')
    [ -n "$exec_cmd" ] || { warn ".desktop 里没有 Exec，跳过启动器生成"; return 0; }

    # Exec 常常是包一层的 launch.sh / start.sh —— 这类脚本里常有发行版检查
    # （网易邮箱大师就是被 launch.sh 里的 lsb_release 判断拦下的），直接 exec
    # 它等于没绕开。所以遇到 *launch*.sh / *start*.sh / *run*.sh 就在同目录里
    # 找一个同名的真身二进制。
    bin=$exec_cmd
    case "$(basename "$exec_cmd")" in
        launch.sh|start.sh|run.sh|*.sh)
            appdir=$(dirname "$exec_cmd")
            local cand want1 want2
            want1=$(basename "$appdir")            # /opt/mailmaster → mailmaster
            want2=$(basename "$d" .desktop)        # mailmaster.desktop → mailmaster
            for cand in "$appdir/$want1" "$appdir/$want2"; do
                if [ -f "$cand" ] && [ -x "$cand" ]; then bin=$cand; break; fi
            done
            if [ "$bin" = "$exec_cmd" ]; then
                warn "没能从 $(basename "$exec_cmd") 里认出真身二进制，仍指向它"
                warn "  若该脚本含发行版检查（lsb_release 之类），请在 $COMPAT_ENV_DIR 下另行处理"
            fi
            ;;
    esac

    srcname=$(basename "$d" .desktop)          # 如 mailmaster
    title=$(awk -F= '/^Name=/{print $2; exit}' "$d")
    [ -n "$title" ] || title=$srcname

    mkdir -p "$HOME/.local/bin" "$HOME/.local/share/applications" "$COMPAT_ENV_DIR"
    dest="$HOME/.local/bin/$srcname"

    # 已存在同名启动器 → 不是本工具生成的就先备份，别把用户自己的东西冲掉
    if [ -e "$dest" ] && ! grep -q 'debinstall 兼容启动器' "$dest" 2>/dev/null; then
        cp -f "$dest" "$dest.bak-$(date +%Y%m%d-%H%M%S)"
        warn "$dest 已存在且不是本工具生成的，原文件已备份"
    fi

    cat > "$dest" <<WRAPPER
#!/bin/bash
# debinstall 兼容启动器 —— 自动生成，可手动编辑；重新生成会保留本文件里的改动
# 之外的部分（应用专属修复请写进 $COMPAT_ENV_DIR/$srcname.env）
APP_DIR="${bin%/*}"
COMPAT_DIR="$COMPAT_DIR"

export LD_LIBRARY_PATH="\$COMPAT_DIR\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
# 应用专属修复（不被重新生成冲掉）
[ -f "$COMPAT_ENV_DIR/$srcname.env" ] && . "$COMPAT_ENV_DIR/$srcname.env"

cd "\$APP_DIR" 2>/dev/null || true
exec "$bin" "\$@"
WRAPPER
    chmod +x "$dest"
    ok "兼容启动器 → $dest"

    # 用户级 .desktop：优先于 /usr/share/applications 里的同名文件
    local ud="$HOME/.local/share/applications/$srcname.desktop"
    if [ -e "$ud" ] && ! grep -q 'X-DebInstall-Wrapper=1' "$ud" 2>/dev/null; then
        cp -f "$ud" "$ud.bak-$(date +%Y%m%d-%H%M%S)"
        warn "$ud 已存在且不是本工具生成的，原文件已备份"
    fi
    awk -v ex="$dest %U" '
        /^Exec=/   { print "Exec=" ex; next }
        /^TryExec=/ { next }
        { print }
    ' "$d" > "$ud.tmp"
    grep -q '^X-DebInstall-Wrapper=' "$ud.tmp" || \
        printf 'X-DebInstall-Wrapper=1\n' >> "$ud.tmp"
    mv -f "$ud.tmp" "$ud"
    have update-desktop-database && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1
    ok "用户级桌面入口 → $ud（已指向启动器）"

    # 生成一个空的 env 文件当模板，让用户知道去哪儿加应用专属修复
    local envf="$COMPAT_ENV_DIR/$srcname.env"
    if [ ! -e "$envf" ]; then
        cat > "$envf" <<'ENVEOF'
# debinstall 应用专属修复。这里的 export 会在启动器里生效，
# 且重新生成启动器时不会被冲掉。例如：
#   export QT_XCB_GL_INTEGRATION=none    # 自带 Qt5 的 GLX 在 Mesa 上段错误
#   export QT_QPA_PLATFORM=xcb
ENVEOF
        ok "应用专属修复模板 → $envf"
    fi
    return 0
}

# ---------------------------------------------------------------- 元数据
field() { dpkg-deb --field "$DEB" "$1" 2>/dev/null | head -1 || true; }

split_version() {   # $1 = Debian 版本号 → 回显 "pkgver pkgrel"
    local v=$1 up rev
    v=${v//[[:space:]]/}
    v=${v#*:}                       # 丢掉 epoch
    if [ "${v#*-}" != "$v" ]; then  # 有 Debian revision
        rev=${v##*-}; up=${v%-*}
    else
        rev=1; up=$v
    fi
    # Arch 的 pkgver 不能含 - 和 :，其余非法字符统一换成 .
    up=$(printf '%s' "$up" | tr -c 'A-Za-z0-9._+' '.')
    up=${up#.}; up=${up%.}
    [ -n "$up" ] || up=1
    rev=$(printf '%s' "$rev" | tr -c 'A-Za-z0-9.' '.')
    rev=${rev#.}; rev=${rev%.}
    [ -n "$rev" ] || rev=1
    printf '%s %s\n' "$up" "$rev"
}

map_arch() {
    case "${1,,}" in
        amd64|x86_64)  echo x86_64 ;;
        arm64|aarch64) echo aarch64 ;;
        i386|i486|i586|i686) echo i686 ;;
        armhf|armv7l)  echo armv7h ;;
        all|any|noarch) echo any ;;
        *) echo "${1,,}" ;;
    esac
}

sanitize_name() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9@._+-' '-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'
}

# ---------------------------------------------------------------- 依赖推导
# 收集目录下所有 ELF 的 DT_NEEDED 声名
elf_sonames() {
    local d=$1 f magic
    find "$d" -type f \( -perm -u+x -o -name '*.so' -o -name '*.so.*' \) -print0 2>/dev/null |
    while IFS= read -r -d '' f; do
        [ -L "$f" ] && continue
        magic=$(head -c 4 "$f" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')
        [ "$magic" = "7f454c46" ] || continue
        readelf -d "$f" 2>/dev/null | sed -n 's/.*(NEEDED)[^[]*\[\(.*\)\]/\1/p'
    done | sort -u
}

# 包自己带的 soname（不需要外部依赖）
shipped_sonames() {
    find "$1" \( -name '*.so' -o -name '*.so.*' \) -printf '%f\n' 2>/dev/null | sort -u
}

# soname → Arch 包名。用 pacman 文件数据库反查，优先 core > extra > multilib，
# 排除 lib32-*（除非目标就是 32 位包）与第三方仓库。
# 只认真正的库目录 usr/lib*/，避免把 aarch64/riscv64 交叉工具链里的同名库算进来。
#
# 【性能】逐个 soname 调一次 pacman -F 很慢（实测 4 个库 33.7s），
# 批量一次调用只要 9.2s（14 个库 ~30s）。所以这里走批量：
#   stdin  = soname 列表（一行一个）
#   stdout = "soname<TAB>包名"
resolve_sonames() {
    local -a list=()
    local s
    while IFS= read -r s; do
        [ -n "$s" ] && list+=("$s")
    done
    [ ${#list[@]} -eq 0 ] && return 0

    pacman -F "${list[@]}" 2>/dev/null | awk '
        /^[A-Za-z0-9_.+-]+\// {
            repo = $0; sub(/\/.*/, "", repo)
            pkg  = $0; sub(/^[^/]*\//, "", pkg); sub(/[ \t].*/, "", pkg)
            next
        }
        /^[ \t]+usr\/lib/ {
            p = $1
            n = split(p, parts, "/")
            base = parts[n]
            if (base == "") next
            if (p ~ /^usr\/lib32\//) { if (!(base in M32)) M32[base] = pkg; next }
            if (p !~ /^usr\/lib\//)  next          # 跳过 usr/lib64、交叉工具链等
            if      (repo == "core")     { if (!(base in C))  C[base]  = pkg }
            else if (repo == "extra")    { if (!(base in E))  E[base]  = pkg }
            else if (repo == "multilib") { if (!(base in MU)) MU[base] = pkg }
            else                         { if (!(base in L))  L[base]  = pkg }
        }
        END {
            for (b in C)  print b "\t" C[b]
            for (b in E)  if (!(b in C)) print b "\t" E[b]
            for (b in MU) if (!(b in C) && !(b in E)) print b "\t" MU[b]
            for (b in L)  if (!(b in C) && !(b in E) && !(b in MU)) print b "\t" L[b]
            for (b in M32) if (!(b in C) && !(b in E) && !(b in MU) && !(b in L)) print b "\t" M32[b]
        }
    '
}

