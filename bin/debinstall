# 解析 Depends 里那些推不出 soname 的条目
map_debian_dep() {
    local d=$1
    d=${d%%:*}                 # 去掉 :any / :amd64
    d=${d%%[[:space:]]*}       # 去掉版本约束
    d=${d%%(*}
    [ -n "$d" ] || return 0
    local hit
    hit=$(builtin_lookup "$d")
    [ -n "$hit" ] && { echo "$hit"; return 0; }
    # 已经在 Arch 仓库里同名存在 → 直接用
    if pacman -Ssq "^${d}$" 2>/dev/null | grep -qx "$d"; then
        echo "$d"; return 0
    fi
    return 0
}

# 检查 Arch 仓库里是否真的有这个包
# 【性能】逐个 pacman -Ssq 反查也是 N 次调用。改成一次 pacman -Slq 拿到全量包名，
# 之后本地比对。首次调用约 1s，随后零成本。
_REPO_PKGS=""
in_repo() {
    if [ -z "$_REPO_PKGS" ]; then
        _REPO_PKGS=$(pacman -Slq 2>/dev/null | sort -u)
        [ -n "$_REPO_PKGS" ] || { _REPO_PKGS="__EMPTY__"; return 1; }
    fi
    grep -qxF "$1" <<<"$_REPO_PKGS"
}

# ---------------------------------------------------------------- 只读分析
# 输出刻意做成「人看得懂 + GUI 能解析」两种用途兼顾：
#   * 每段以 ==> 开头，GUI 据此上色
#   * 结果行以 ✓ / ! / ✗ 开头，GUI 据此判定严重程度
#   * 包名 / 版本 / 架构 顶格跟在两个空格后，GUI 的摘要卡片正则直接抓
analyze_deb() {
    local name ver darch pv pr aarch S
    name=$(field Package); ver=$(field Version); darch=$(field Architecture)
    read -r pv pr <<<"$(split_version "$ver")"
    aarch=$(map_arch "$darch")
    S=$(mktemp -d)
    dpkg-deb -x "$DEB" "$S/root" >/dev/null 2>&1
    dpkg-deb -e "$DEB" "$S/ctl" >/dev/null 2>&1

    echo
    info "包信息"
    printf '  %s %s\n' "包名        " "$name"
    printf '  %s %s\n' "版本        " "$ver"
    printf '  %s %s\n' "架构        " "$darch"
    printf '  %s %s\n' "描述        " "$(field Description)"
    printf '  %s %s\n' "主页        " "$(field Homepage)"
    printf '  %s %s\n' "维护者      " "$(field Maintainer)"
    printf '  %s %s\n' "文件数      " "$(find "$S/root" -type f 2>/dev/null | wc -l)"
    printf '  %s %s-%s\n' "Arch 版本  " "$pv" "$pr"
    printf '  %s %s\n' "Arch 架构  " "$aarch"
    case "${darch,,}" in
        amd64|x86_64|all|any|noarch) ok "架构匹配本机" ;;
        *) warn "架构是 $darch，本机通常需要 x86_64" ;;
    esac

    echo
    info "安装脚本审计"
    audit_scriptlets "$S/ctl"

    echo
    info "写入路径"
    check_top_paths "$S/root"

    echo
    info "动态库依赖解析"
    printf '  %s.deb 声明的依赖（Depends / Pre-Depends）：%s\n' "$CD" "$C0"
    printf '    %s\n' "$(field Depends)"
    [ -n "$(field Pre-Depends)" ] && printf '    %s\n' "$(field Pre-Depends)"
    local s pkg n_ok=0 n_no=0
    local shipped; shipped=$(shipped_sonames "$S/root")
    local missing=""
    local need_sonames
    need_sonames=$(elf_sonames "$S/root" | grep -vxF "$(printf '%s\n' "$shipped")" 2>/dev/null || true)
    local resolved; resolved=$(printf '%s\n' "$need_sonames" | resolve_sonames)
    for s in $need_sonames; do
        pkg=$(awk -F'\t' -v k="$s" '$1==k{print $2; exit}' <<<"$resolved")
        if [ -n "$pkg" ]; then
            printf '    %-30s → %s\n' "$s" "$pkg"
            n_ok=$((n_ok+1))
        else
            printf '    %-30s → %s未找到%s\n' "$s" "$CY" "$C0"
            missing="$missing$s "
            n_no=$((n_no+1))
        fi
    done
    if [ $((n_ok+n_no)) -eq 0 ]; then
        warn "没找到可执行文件，跳过 ldd 检查"
    elif [ "$n_no" -gt 0 ]; then
        bad "缺失库 $n_no 个，Arch 仓库不提供：$missing"
        if [ $COMPAT_LIBS -eq 1 ]; then
            printf '      %s→ 装的时候会自动从 Debian 取到 %s%s\n' "$CD" "$COMPAT_DIR" "$C0"
            printf '      %s→ 并生成兼容启动器（LD_LIBRARY_PATH 得有人注入）+ 用户级桌面入口%s\n' "$CD" "$C0"
            printf '      %s→ 不想让它动这些：加 --no-compat%s\n' "$CD" "$C0"
        else
            printf '      %s→ 已用 --no-compat 关闭自动补库，需自行处理%s\n' "$CD" "$C0"
        fi
    else
        ok "所有动态库已满足（$n_ok 个）"
    fi

    echo
    info "冲突检测"
    check_desktop_shadow "$S/root"
    check_ll_cli "$name"

    rm -rf "$S"
}

[ "$MODE" = analyze ] && { analyze_deb; exit 0; }

# ---------------------------------------------------------------- 生成 .INSTALL
make_install_script() {   # $1 = ctl 目录, $2 = 输出文件
    local ctl=$1 out=$2
    local any=0
    # 只统计真正会生成钩子的脚本：默认不含移除阶段
    for f in preinst postinst; do
        [ -s "$ctl/$f" ] && any=1
    done
    if [ $RUN_REMOVE_HOOKS -eq 1 ]; then
        for f in prerm postrm; do
            [ -s "$ctl/$f" ] && any=1
        done
    fi
    [ $any -eq 0 ] && return 1
    [ $RUN_SCRIPTLETS -eq 0 ] && return 1

    {
        echo '#!/bin/bash'
        echo '# Generated by debinstall — 运行 .deb 自带的维护脚本（尽力而为，失败不影响安装）'
        echo
        cat <<'HDR'
_db_run() {
    local label="$1" b64="$2" action="$3" ver="$4"
    local d; d="$(mktemp -d)" || return 0
    printf '%s' "$b64" | base64 -d > "$d/s" 2>/dev/null || { rm -rf "$d"; return 0; }
    chmod 755 "$d/s"
    if [ -d /usr/local/lib/debinstall/shims ]; then
        export PATH="/usr/local/lib/debinstall/shims:$PATH"
    fi
    export DEBIAN_FRONTEND=noninteractive
    export DEBINSTALL_SCRIPTLET="$label"
    bash "$d/s" "$action" "$ver" >/dev/null 2>&1 || true
    rm -rf "$d"
    return 0
}
HDR
        echo
        for f in preinst postinst prerm postrm; do
            [ -s "$ctl/$f" ] || continue
            printf '%s_B64() { printf %%s \x27%s\x27; }\n' "$f" "$(base64 -w0 < "$ctl/$f")"
        done
        echo
        if [ -s "$ctl/preinst" ]; then
            cat <<'X'
pre_install()  { _db_run "preinst"  "$(preinst_B64)"  "install" "$1"; }
pre_upgrade()  { _db_run "preinst"  "$(preinst_B64)"  "upgrade" "$2"; }
X
        fi
        if [ -s "$ctl/postinst" ]; then
            cat <<'X'
post_install() { _db_run "postinst" "$(postinst_B64)" "configure" "$1"; }
post_upgrade() { _db_run "postinst" "$(postinst_B64)" "configure" "$2"; }
X
        fi
        if [ $RUN_REMOVE_HOOKS -eq 1 ]; then
            if [ -s "$ctl/prerm" ]; then
                cat <<'X'
pre_remove()   { _db_run "prerm"    "$(prerm_B64)"    "remove" "$1"; }
X
            fi
            if [ -s "$ctl/postrm" ]; then
                cat <<'X'
post_remove()  { _db_run "postrm"   "$(postrm_B64)"   "remove" "$1"; }
X
            fi
        else
            cat <<'X'
# 移除阶段钩子默认不生成：debian 的 prerm/postrm 在 Arch 上基本是空转
# （update-alternatives / AppArmor / systemd 单元清理都用不上），
# 却会在你早已忘记安装时那份警告的情况下、以 root 执行外来代码。
# 确需执行请加 --run-remove-hooks。
X
        fi
    } > "$out"
    return 0
}

# ---------------------------------------------------------------- 构建 Arch 包
build_arch_pkg() {   # $1 = 输出目录 → 回显生成的包路径
    local outdir=$1
    info "读取 .deb 元数据"
    local name ver darch pv pr desc url
    name=$(field Package); ver=$(field Version); darch=$(field Architecture)
    desc=$(field Description); url=$(field Homepage)
    [ -n "$name" ] || die "这个 .deb 没有 Package 字段，可能不是标准 Debian 包"
    name=$(sanitize_name "$name")
    read -r pv pr <<<"$(split_version "$ver")"
    local aarch; aarch=$(map_arch "$darch")

    if [ "$aarch" != "any" ] && [ "$aarch" != "$(uname -m)" ]; then
        warn "这是 $darch（$aarch）的包，本机是 $(uname -m)。"
        [ "$aarch" = "i686" ] && warn "32 位包需要 multilib 里的 lib32-* 运行库，且 pacman 可能拒绝安装。"
        warn "继续转换，但安装很可能失败。"
    fi

    # 与已存在的 Arch 包重名 → 加 -deb 后缀
    if in_repo "$name"; then
        warn "仓库里已有同名包 $name，改名安装为 ${name}-deb 以避免混淆"
        name="${name}-deb"
    fi

    local root="$WORK/root" ctl="$WORK/ctl"
    mkdir -p "$root" "$ctl"
    info "解包 .deb 数据"
    dpkg-deb -x "$DEB" "$root" || die "解包数据失败"
    dpkg-deb -e "$DEB" "$ctl" 2>/dev/null || true

    # 目录权限规范化。.deb 里目录常是 775（drwxrwxr-x），照搬的后果：
    #   * pacman 会对已存在的 /opt、/usr/share 等目录报「目录权限不一致」
    #   * 包新建的 /opt/<app> 也变成组可写 —— 组里有人就能替换应用二进制
    # 只动目录、不动文件（有些包确实需要文件带特殊位）。
    if [ -z "${DEBINSTALL_KEEP_DIR_PERM:-}" ]; then
        find "$root" -type d -exec chmod go-w {} + 2>/dev/null || true
    fi

    # ---------- 依赖 ----------
    info "推导依赖（ELF NEEDED → pacman 文件库反查）"
    local shipped deps=() s pkg
    shipped=$(shipped_sonames "$root")
    local need_sonames resolved
    need_sonames=$(elf_sonames "$root" | grep -vxF "$(printf '%s\n' "$shipped")" 2>/dev/null || true)
    resolved=$(printf '%s\n' "$need_sonames" | resolve_sonames)
    for s in $need_sonames; do
        pkg=$(awk -F'\t' -v k="$s" '$1==k{print $2; exit}' <<<"$resolved")
        [ -n "$pkg" ] && deps+=("$pkg")
    done

    # .deb 声明的依赖里，映射表能对上的也补进来
    local dd mapped
    while IFS= read -r dd; do
        [ -n "$dd" ] || continue
        mapped=$(map_debian_dep "$dd")
        [ -n "$mapped" ] && deps+=("$mapped")
    done < <(printf '%s\n' "$(field Depends)" "$(field Pre-Depends)" \
             | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' \
             | sed 's/|/\n/g' | sed 's/^[[:space:]]*//' | awk '!seen[$0]++')

    # 去重 + 只保留仓库里真实存在的
    local uniq=() d
    if [ ${#deps[@]} -gt 0 ]; then
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            [ "$d" = "$name" ] && continue
            if in_repo "$d"; then uniq+=("$d")
            else warn "依赖 $d 在仓库中不存在，已跳过"; fi
        done < <(printf '%s\n' "${deps[@]}" | sort -u)
    fi

    # ---------- .PKGINFO ----------
    local size epoch
    size=$(du -sb --exclude='.PKGINFO' --exclude='.INSTALL' --exclude='.MTREE' "$root" 2>/dev/null | cut -f1)
    epoch=$(date +%s)
    {
        echo "# Generated by debinstall $VERSION"
        echo "pkgname = $name"
        echo "pkgbase = $name"
        echo "xdata = pkgtype=pkg"
        echo "pkgver = $pv-$pr"
        echo "pkgdesc = $(printf '%s' "${desc:-Debian package $name}" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g' | cut -c1-200)"
        [ -n "$url" ] && echo "url = $url"
        echo "builddate = $epoch"
        echo "packager = debinstall <debinstall@localhost>"
        echo "size = ${size:-0}"
        echo "arch = $aarch"
        echo "license = custom"
        for d in "${uniq[@]:-}"; do [ -n "$d" ] && echo "depend = $d"; done
    } > "$root/.PKGINFO"

    # ---------- .INSTALL ----------
    if make_install_script "$ctl" "$root/.INSTALL"; then
        info "已生成 .INSTALL（会执行 .deb 自带的 postinst/prerm 等）"
    fi

    # ---------- 打包 ----------
    info "打包为 Arch 包"
    local pkgfile="${name}-${pv}-${pr}-${aarch}.pkg.tar.zst"
    mkdir -p "$outdir"
    cat > "$WORK/_build.sh" <<'BUILD'
set -e
cd "$1"
export LC_ALL=C LANG=C

# 注意：这里绝对不能用 -n！GNU tar 的 -n 是 --seek（写盘时忽略），
# 但 bsdtar 的 -n 是 --no-recursion，会让目录只进一个空壳、包变成空的。
opt=()
[ -f .INSTALL ] && opt+=(.INSTALL)

mapfile -t tops < <(find . -mindepth 1 -maxdepth 1 \
        ! -name '.PKGINFO' ! -name '.INSTALL' ! -name '.MTREE' -printf '%P\n' | LC_ALL=C sort)

# 1) .MTREE（不包含自身）
{ printf '%s\0' .PKGINFO "${opt[@]}" "${tops[@]}"; } \
  | bsdtar -cf - --format=mtree \
        --options='!all,use-set,type,uid,gid,mode,time,size,sha256,link' \
        --null --files-from - \
  | gzip -c -f -n > .MTREE

# 2) 真正的包：元数据在前，文件树在后
{ printf '%s\0' .PKGINFO "${opt[@]}" .MTREE "${tops[@]}"; } \
  | bsdtar --no-fflags --no-read-sparse -cf - --null --files-from - \
  | zstd -q -c -T0 > "$2"
BUILD
    fakeroot -- bash "$WORK/_build.sh" "$root" "$outdir/$pkgfile" \
        || die "打包失败（fakeroot 阶段出错）"
    [ -s "$outdir/$pkgfile" ] || die "打包失败：输出为空"

    # 自检：包里的条目数必须和源树对得上（防目录被吞成空壳的静默失败）
    local n_src n_pkg
    n_src=$(find "$root" -mindepth 1 | wc -l)
    n_pkg=$(bsdtar -tf "$outdir/$pkgfile" 2>/dev/null | wc -l)
    if [ "$n_pkg" -lt "$n_src" ]; then
        err "打包自检失败：源树 $n_src 个条目，包里只有 $n_pkg 个。"
        err "（这是 bug，已中止，以免装出一个空包）"
        exit 1
    fi
    # 再确认 .PKGINFO / .MTREE 齐备
    for m in .PKGINFO .MTREE; do
        bsdtar -tf "$outdir/$pkgfile" 2>/dev/null | grep -qx "$m" || die "打包自检失败：缺少 $m"
    done

    ok "已生成 $outdir/$pkgfile （$(du -h "$outdir/$pkgfile" | cut -f1)，$n_pkg 个条目）"
    printf '%s\n' "$outdir/$pkgfile"
}

# ---------------------------------------------------------------- 安装到系统
do_install() {
    detect_escalation
    local pkg
    pkg=$(build_arch_pkg "$WORK/out" | tail -1)
    [ -f "$pkg" ] || die "构建未产出包文件"

    # 把 update-alternatives shim 落到 SHIMDIR，供 .INSTALL 里的钩子使用
    if write_shim "$SHIMDIR" run_root; then
        info "已就绪 update-alternatives shim（$SHIMDIR）"
    else
        warn "update-alternatives shim 未能写入 $SHIMDIR，个别包的命令名可能缺失"
    fi

    info "用 pacman 安装（这一步需要 root，会弹出授权框或要求输入密码）"
    local args=(-U --noconfirm)
    [ $OVERWRITE -eq 1 ] && { args+=(--overwrite); args+=('*'); warn "已启用 --overwrite，可能覆盖系统文件"; }
    if run_root "$PACMAN" "${args[@]}" "$pkg"; then
        ok "安装完成：$name_of_pkg"
        echo
        info "收尾"
        # 补库要在桌面快捷方式之前做：它会生成用户级 .desktop，而桌面上那份
        # 应当指向兼容启动器而不是包自带的 Exec。
        # 复用 build_arch_pkg 解好的 $WORK/root，别再解一次 —— 有些包解开来
        # 200MB 以上（网易邮箱大师 217MB），多解一次纯属浪费。
        if [ $COMPAT_LIBS -eq 1 ]; then
            local croot="$WORK/root"
            if [ ! -d "$croot" ]; then
                mkdir -p "$croot"
                dpkg-deb -x "$DEB" "$croot" 2>/dev/null || warn "重新解包失败，跳过补库检查"
            fi
            [ -d "$croot" ] && setup_compat_libs "$croot"
        fi
        [ $MAKE_DESKTOP -eq 1 ] && make_desktop_shortcut
        fix_electron
        warn "启动测试时记得避开 ELECTRON_RUN_AS_NODE 污染（脚本环境里常被误设）"
        printf '      %s setsid env -u ELECTRON_RUN_AS_NODE %s\n' "$PROG" "<应用路径>"
        printf '      %s（从桌面图标启动不受影响，只有脚本里跑才会踩到）\n' "$CD"
        printf '%s\n' "$CD"
        printf '      装完请实际点一次图标确认能起来 —— 只发 .deb 的国产客户端\n'
        printf '      常带发行版检查脚本或旧版 GUI 库，光看安装成功说明不了问题。%s\n' "$C0"
    else
        err "pacman 安装失败。"
        echo >&2
        warn "如果失败原因是文件冲突或依赖不满足，两个选择："
        warn "  1) 换用户级安装（不需要 root，通常可行）："
        warn "       $PROG -l \"$DEB\""
        warn "  2) 明知冲突仍要覆盖（危险，请先看清楚冲突清单）："
        warn "       $PROG --overwrite \"$DEB\""
        [ $KEEP -eq 1 ] || { cp -n "$pkg" "$PWD/" 2>/dev/null && warn "生成的包已留在 $PWD/$(basename "$pkg") 供你手动处理"; }
        exit 1
    fi

    if [ $KEEP -eq 1 ]; then
        local dest=${OUTDIR:-$PWD}
        mkdir -p "$dest"; cp -f "$pkg" "$dest/"
        ok "Arch 包已保留到 $dest/$(basename "$pkg")"
    fi
}

# ---------------------------------------------------------------- 解包到本地
local_extract() {   # $1 = 目标根目录, $2 = 包名
    local dest=$1
    mkdir -p "$dest"
    dpkg-deb -x "$DEB" "$dest" || die "解包失败"
}

rewrite_desktop() {  # $1 = 原始 desktop 文件, $2 = 本地安装根, $3 = 记录文件
    local src=$1 root=$2 man=$3 line out key val first rest path
    out="$WORK/$(basename "$src")"
    : > "$out"
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            Exec=*|TryExec=*|Path=*)
                key=${line%%=*}; val=${line#*=}
                read -r first rest <<<"$val" || true
                first=${first:-}; rest=${rest:-}
                path=""
                if [ -n "$first" ]; then
                    if [ "${first:0:1}" = "/" ]; then
                        [ -e "$root$first" ] && path="$root$first"
                    else
                        [ -x "$root/usr/bin/$first" ] && path="$root/usr/bin/$first"
                        [ -z "$path" ] && [ -x "$root/usr/games/$first" ] && path="$root/usr/games/$first"
                    fi
                fi
                if [ "$key" = "TryExec" ] && [ -z "$path" ]; then
                    continue          # TryExec 找不到就丢掉，免得启动器被禁用
                fi
                if [ -n "$path" ]; then
                    printf '%s=%s%s\n' "$key" "$path" "${rest:+ $rest}" >> "$out"
                else
                    printf '%s\n' "$line" >> "$out"
                fi
                ;;
            Icon=*)
                val=${line#Icon=}
                if [ "${val:0:1}" = "/" ]; then
                    [ -e "$root$val" ] && printf 'Icon=%s\n' "$root$val" >> "$out" || printf '%s\n' "$line" >> "$out"
                else
                    printf '%s\n' "$line" >> "$out"
                fi
                ;;
            *) printf '%s\n' "$line" >> "$out" ;;
        esac
    done < "$src"
    printf '%s\n' "$out"
}

# 本地安装的已知局限，主动检测而不是让它静默失败：
# Debian 的包装脚本常按【绝对路径】调用同包的其它二进制
# （典型：figlet-utf8 里 `exec /usr/bin/figlet-figlet`）。
# 本地模式下文件躺在 ~/.local/debinst/<pkg>/usr/bin/，真实 /usr/bin 里没有，
# 于是命令能点到、一跑就报「没有那个文件或目录」。
# 这里扫出这类引用并提醒用户改用系统安装。
warn_local_abs_refs() {   # $1 = 本地安装根；有发现则返回 1
    local dest=$1 f ref found=0
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        [ -L "$f" ] && continue
        # 只看脚本，二进制不看
        [ "$(head -c 2 "$f" 2>/dev/null)" = "#!" ] || continue
        while IFS= read -r ref; do
            [ -n "$ref" ] || continue
            [ -e "$ref" ] && continue          # 本机已有，没事
            [ -d "$(dirname "$ref")" ] || true
            printf '%s\n' "$ref"
            found=1
        done < <(grep -ohE '/(usr|opt)/[A-Za-z0-9._+/-]+' "$f" 2>/dev/null | sort -u)
    done < <(find "$dest/usr/bin" "$dest/usr/games" "$dest/usr/libexec" -type f 2>/dev/null)

    if [ $found -eq 1 ]; then
        return 1
    fi
    return 0
}

do_local() {
    local name ver pv pr
    name=$(sanitize_name "$(field Package)")
    ver=$(field Version)
    [ -n "$name" ] || die "这个 .deb 没有 Package 字段"
    read -r pv pr <<<"$(split_version "$ver")"

    local dest="$LOCALROOT/$name"
    mkdir -p "$HOME/.local/bin" "$HOME/.local/share/applications"
    if [ -d "$dest" ]; then
        warn "$name 已经装过，先覆盖旧的"
        rm -rf "$dest"
    fi
    info "解包到 $dest（不需要 root）"
    local_extract "$dest" "$name"

    local manifest="$dest/.debinstall-manifest"; : > "$manifest"
    {
        echo "name=$name"
        echo "version=$pv-$pr"
        echo "source=$DEB"
        echo "installed=$(date -Iseconds)"
    } > "$dest/.debinstall-info"

    # 可执行文件 → ~/.local/bin 软链
    local f b
    for d in usr/bin usr/games usr/local/bin; do
        [ -d "$dest/$d" ] || continue
        for f in "$dest/$d"/*; do
            [ -f "$f" ] && [ -x "$f" ] || continue
            b=$(basename "$f")
            ln -sfn "$f" "$HOME/.local/bin/$b"
            echo "$HOME/.local/bin/$b" >> "$manifest"
        done
    done

    # 图标 → ~/.local/share/icons（保持 hicolor 层级）
    if [ -d "$dest/usr/share/icons" ]; then
        ( cd "$dest/usr/share/icons" && find . -type f -print0 ) |
        while IFS= read -r -d '' rel; do
            local tgt="$HOME/.local/share/icons/${rel#./}"
            mkdir -p "$(dirname "$tgt")"
            cp -f "$dest/usr/share/icons/${rel#./}" "$tgt" 2>/dev/null && echo "$tgt" >> "$manifest"
        done
    fi
    if [ -d "$dest/usr/share/pixmaps" ]; then
        mkdir -p "$HOME/.local/share/pixmaps"
        for f in "$dest/usr/share/pixmaps"/*; do
            [ -f "$f" ] || continue
            cp -f "$f" "$HOME/.local/share/pixmaps/" && echo "$HOME/.local/share/pixmaps/$(basename "$f")" >> "$manifest"
        done
    fi

    # .desktop → 重写路径后装到 ~/.local/share/applications
    if [ -d "$dest/usr/share/applications" ]; then
        for f in "$dest/usr/share/applications"/*.desktop; do
            [ -f "$f" ] || continue
            local newd tgt
            newd=$(rewrite_desktop "$f" "$dest" "$manifest" | tail -1)
            [ -f "$newd" ] || continue
            tgt="$HOME/.local/share/applications/$(basename "$f")"
            cp -f "$newd" "$tgt"
            echo "$tgt" >> "$manifest"
        done
    fi

    # 桌面目录里可能还引用 /usr/share/applications 的绝对路径，一并纠正
    if [ -d "$dest/usr/share/applications" ]; then
        for f in "$HOME/.local/share/applications"/*.desktop; do
            [ -f "$f" ] || continue
            grep -q "$dest" "$f" 2>/dev/null || continue
            sed -i "s|/usr/share/applications/$name\.desktop|$dest/usr/share/applications/$name.desktop|g" "$f"
        done
    fi

    have update-desktop-database && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1
    have gtk-update-icon-cache && gtk-update-icon-cache -qtf "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1

    # 补 update-alternatives 生成的命令名（本地模式不跑 postinst，得自己来）
    local _ctl="$WORK/ctl-local"
    mkdir -p "$_ctl" && dpkg-deb -e "$DEB" "$_ctl" 2>/dev/null
    emulate_alternatives_local "$dest" "$_ctl" "$manifest"

    ok "$name 已装到 $dest"
    [ $MAKE_DESKTOP -eq 1 ] && make_desktop_shortcut "$HOME/.local/share/applications"
    msg ""
    msg "  可执行文件软链： ~/.local/bin/"
    msg "  桌面入口：       ~/.local/share/applications/"
    if [ -d "$dest/usr/lib" ] || [ -d "$dest/opt" ]; then
        msg "  提示：这个包自带运行库，若启动报缺库，可试"
        msg "        LD_LIBRARY_PATH=\"$dest/usr/lib\" <程序>"
    fi
    msg "  卸载：$PROG -R $name"

    # 已知局限提醒：包装脚本硬编码 /usr 绝对路径
    local _refs
    _refs=$(warn_local_abs_refs "$dest" || true)
    if [ -n "$_refs" ]; then
        echo
        warn "这个包里有脚本按绝对路径调用同包的其它文件，本机该路径不存在："
        printf '%s\n' "$_refs" | sort -u | sed 's/^/        /'
        warn "本地安装下这些命令能点到但一跑就报错。改用系统安装即可："
        printf '      %s --install --no-desktop "%s"\n' "$PROG" "$DEB"
    fi
}

# ---------------------------------------------------------------- 主流程
case "$MODE" in
    install)
        WORK=$(mktemp -d /tmp/debinstall.XXXXXX)
        # 先体检。让「装」这个动作永远发生在看清楚之后 —— .deb 自带的
        # postinst 会以 root 执行，不给用户看一眼就装是不负责任的。
        analyze_deb
        echo
        detect_escalation
        name_of_pkg=$(sanitize_name "$(field Package)")
        if [ "$DANGER" -eq 1 ]; then
            bad "上面这个包的自带脚本含高危操作，安装后它会以 root 执行"
            if [ $ASSUME_YES -eq 0 ]; then
                if [ -t 0 ]; then
                    printf '  确认信任并继续安装？输入 yes 才继续： '
                    read -r a; [ "$a" = "yes" ] || die "已取消"
                elif [ $ALLOW_DANGER -eq 0 ]; then
                    die "非交互模式下拒绝安装高危包（确认信任请加 --allow-dangerous）"
                fi
            fi
        elif [ $ASSUME_YES -eq 0 ] && [ -t 0 ]; then
            printf '转换为 Arch 包并用 pacman 安装？[Y/n] '
            read -r a; case "$a" in [nN]*) die "已取消" ;; esac
        fi
        do_install
        ;;
    convert)
        WORK=$(mktemp -d /tmp/debinstall.XXXXXX)
        pkg=$(build_arch_pkg "${OUTDIR:-$PWD}" | tail -1)
        msg ""
        ok "完成。用 sudo pacman -U \"$pkg\" 安装。"
        ;;
    local)
        WORK=$(mktemp -d /tmp/debinstall.XXXXXX)
        do_local
        ;;
    extract)
        [ -n "$EXTRACT_DIR" ] || die "-x 需要指定目标目录"
        WORK=$(mktemp -d /tmp/debinstall.XXXXXX)
        info "解包到 $EXTRACT_DIR"
        dpkg-deb -x "$DEB" "$EXTRACT_DIR" || die "解包失败"
        ok "完成：$EXTRACT_DIR"
        ;;
    *)
        die "未知模式：$MODE" ;;
esac
